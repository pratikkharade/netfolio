# Plaid environment: sandbox or production
PLAID_ENV=production

# Plaid application credentials
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=

# One access token per connected institution
PLAID_US_BANK_ACCESS_TOKEN=
PLAID_CHASE_ACCESS_TOKEN=
PLAID_ROBINHOOD_ACCESS_TOKEN=

# Used by npm run portfolio:sync. GitHub Actions uses GOOGLE_SERVICE_ACCOUNT_JSON instead.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
